# ─── App ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://www.saferide-africa.com

# ─── M-Pesa Daraja (Safaricom) ────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke after going live
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_SHORTCODE=522533
MPESA_CALLBACK_URL=https://your-project.supabase.co/functions/v1/mpesa-callback?secret=<random-secret>
MPESA_CALLBACK_SECRET=<same-random-secret>   # validated by mpesa-callback function

# ─── Backend / Supabase (when you add a real database) ────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Email notifications (optional) ──────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_key_here
NOTIFICATION_EMAIL=saferideafrica777@gmail.com
