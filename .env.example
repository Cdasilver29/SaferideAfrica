# ─── App ──────────────────────────────────────────────────────────────────────
# Canonical site origin. Injected by .github/workflows/deploy.yml.
EXPO_PUBLIC_APP_URL=https://www.saferide-africa.com

# ─── Enrollment lead form ─────────────────────────────────────────────────────
# Web3Forms access key used by the enrollment modal. Get one at web3forms.com.
# Client-side by design, so this value ships in the web bundle.
EXPO_PUBLIC_WEB3FORMS_KEY=your_access_key_here
